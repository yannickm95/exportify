{
  "name": "exportify",
  "version": "1.0.0",
  "private": true,
  "description": "Website to export and sort spotify playlists",
  "homepage": "https://yannickm95.github.io/exportify/",
  "author": "Hatlaron",
  "type": "module",
  "scripts": {
    "build": "vite build && cp dist/index.html dist/404.html",
    "dev": "vite dev",
    "format": "oxfmt --write .",
    "lint": "oxlint --type-aware --type-check",
    "preview": "vite preview",
    "test": "vitest dev",
    "test:ci": "vitest run"
  },
  "dependencies": {
    "@spotify/web-api-ts-sdk": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "file-saver": "^2.0.5",
    "lodash": "^4.18.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "react-toastify": "^11.1.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/confusing-browser-globals": "^1.0.3",
    "@types/file-saver": "^2.0.7",
    "@types/lodash": "^4.17.27",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "confusing-browser-globals": "^1.0.11",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^24.22.1",
      "onFail": "download"
    }
  }
}
