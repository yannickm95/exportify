{
  "name": "exportify",
  "version": "1.0.0",
  "private": true,
  "description": "Website to export and sort spotify playlists",
  "homepage": "https://yannickm95.github.io/exportify/",
  "author": "Hatlaron",
  "type": "module",
  "scripts": {
    "build": "vite build && cp dist/index.html dist/404.html",
    "compare-playlists": "node scripts/compare-playlists.ts",
    "dev": "vite dev",
    "format": "oxfmt --write .",
    "lint": "oxlint --type-aware --type-check",
    "playlist-range": "node scripts/playlist-range.ts",
    "preview": "vite preview",
    "test": "vitest dev",
    "test:ci": "vitest run"
  },
  "dependencies": {
    "@spotify/web-api-ts-sdk": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "file-saver": "^2.0.5",
    "lodash": "^4.18.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "react-toastify": "^11.2.0",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/confusing-browser-globals": "^1.0.3",
    "@types/file-saver": "^2.0.7",
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "confusing-browser-globals": "^1.0.11",
    "csv-parse": "^7.0.3",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^26.13.1",
      "onFail": "download"
    }
  }
}
